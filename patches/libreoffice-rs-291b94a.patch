+fn odf_image_length(value: Option<&str>) -> Option<f32> {
+    let value = value?.trim();
+    for (unit, scale) in [
+        ("cm", 10.0),
+        ("mm", 1.0),
+        ("in", 25.4),
+        ("pt", 25.4 / 72.0),
+        ("pc", 25.4 / 6.0),
+    ] {
+        if let Some(number) = value.strip_suffix(unit) {
+            let mm = number.parse::<f32>().ok()? * scale;
+            return (mm.is_finite() && mm > 0.0 && mm <= 10_000.0).then_some(mm);
+        }
+    }
+    None
+}
