+//! Automatic note references and bodies from the paired MS-DOC PLCs.
+//! https://learn.microsoft.com/en-us/openspecs/office_file_formats/ms-doc/3ed81d85-ea74-4790-8579-ab7f8eb651f7
+use super::fib::Fib;
+use super::piece_table::{Piece, extract_text_range, sanitize_text};
+
+#[derive(Debug, Clone)]
+pub(crate) struct LegacyNote {
+    pub cp: u32,
+    pub id: u32,
+    pub endnote: bool,
+    pub text: String,
+}
+
+fn u32_at(data: &[u8], offset: usize) -> Option<u32> {
+    Some(u32::from_le_bytes(data.get(offset..offset.checked_add(4)?)?.try_into().ok()?))
+}
+
+fn table_part<'a>(word: &[u8], table: &'a [u8], offset: usize) -> Option<&'a [u8]> {
+    let start = u32_at(word, offset)? as usize;
+    let len = u32_at(word, offset + 4)? as usize;
+    table.get(start..start.checked_add(len)?)
+}
+
+// Return main-text CP and note-story [start,end) for each automatic note.
+// Ignore the undefined final CP in both PLCs; never pair mismatched tables.
+fn ranges(refs: &[u8], bodies: &[u8], main_len: u32, story_len: u32) -> Vec<(u32, u32, u32, u32)> {
+    if refs.len() < 10 || (refs.len() - 4) % 6 != 0 { return Vec::new(); }
+    let count = (refs.len() - 4) / 6;
+    if bodies.len() != (count + 2) * 4 { return Vec::new(); }
+    let cps: Vec<u32> = (0..count).map(|i| u32_at(refs, i * 4).unwrap()).collect();
+    let bounds: Vec<u32> = (0..=count).map(|i| u32_at(bodies, i * 4).unwrap()).collect();
+    if cps.iter().any(|&cp| cp >= main_len) || cps.windows(2).any(|w| w[0] >= w[1])
+        || bounds.iter().any(|&cp| cp >= story_len) || bounds.windows(2).any(|w| w[0] >= w[1]) {
+        return Vec::new();
+    }
+    (0..count).filter_map(|i| {
+        let pos = (count + 1) * 4 + i * 2;
+        let automatic = u16::from_le_bytes([refs[pos], refs[pos + 1]]) != 0;
+        automatic.then_some((cps[i], bounds[i], bounds[i + 1], i as u32 + 1))
+    }).collect()
+}
+
+pub(crate) fn parse(word: &[u8], table: &[u8], pieces: &[Piece], fib: &Fib) -> Vec<LegacyNote> {
+    let mut notes = Vec::new();
+    let end_start = fib.text_len.saturating_add(fib.footnote_len)
+        .saturating_add(fib.header_len).saturating_add(fib.comment_len);
+    for (endnote, ref_offset, body_offset, start, len) in [
+        (false, 0xAA, 0xB2, fib.text_len, fib.footnote_len),
+        (true, 0x20A, 0x212, end_start, fib.endnote_len),
+    ] {
+        let (Some(refs), Some(bodies)) = (table_part(word, table, ref_offset), table_part(word, table, body_offset)) else { continue; };
+        for (cp, a, b, id) in ranges(refs, bodies, fib.text_len, len) {
+            if extract_text_range(word, pieces, cp, cp + 1, fib.lid) != "\x02" { continue; }
+            let text = sanitize_text(&extract_text_range(word, pieces, start.saturating_add(a), start.saturating_add(b), fib.lid));
+            notes.push(LegacyNote { cp, id, endnote, text });
+        }
+    }
+    notes.sort_by_key(|n| n.cp);
+    notes
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn pairs_note_bodies_and_ignores_undefined_final_cps() {
+        let mut refs: Vec<u8> = [3u32, 9, u32::MAX].into_iter().flat_map(u32::to_le_bytes).collect();
+        refs.extend([1u16, 1].into_iter().flat_map(u16::to_le_bytes));
+        let bodies: Vec<u8> = [0u32, 7, 12, u32::MAX].into_iter().flat_map(u32::to_le_bytes).collect();
+        assert_eq!(ranges(&refs, &bodies, 10, 13), vec![(3,0,7,1),(9,7,12,2)]);
+        assert!(ranges(&refs, &bodies[..12], 10, 13).is_empty());
+        assert!(ranges(&refs, &bodies, 9, 13).is_empty());
+        assert!(ranges(&refs, &bodies, 10, 12).is_empty());
+        for len in 0..refs.len() { assert!(ranges(&refs[..len], &bodies, 10, 13).is_empty()); }
+        refs[4..8].copy_from_slice(&3u32.to_le_bytes());
+        assert!(ranges(&refs, &bodies, 10, 13).is_empty());
+    }
+}
