+        fn row(index: u16, height: u16) -> Vec<u8> {
+            let mut d = vec![0; 16];
+            d[0..2].copy_from_slice(&index.to_le_bytes());
+            d[6..8].copy_from_slice(&height.to_le_bytes());
+            d[12] = 0x40; // fUnsynced: manually assigned height.
+            biff_rec(0x0208, &d)
+        }
+        let mut body = col(0, 1, 24 * 256 + 128);
+        body.extend(col(1, 1, 100 * 256)); // overwrite, wider than old writer's clamp
+        body.extend(col(3, 3, 128)); // preserve narrow columns too
+        body.extend(row(0, 600));
+        body.extend(row(2, 800)); // trailing blank row must retain its height
+        body.extend(number(0, 0, 0, 42.0));
