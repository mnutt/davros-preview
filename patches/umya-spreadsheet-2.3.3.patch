+
+// The model readers match unprefixed SpreadsheetML names. Adapt the XML stream
+// once at the boundary, resolving namespace URIs (including scoped/rebound
+// prefixes), rather than stripping arbitrary prefixes in hundreds of matches.
+pub(crate) struct SpreadsheetXml<R> {
+    reader: quick_xml::NsReader<R>,
+    buffer: Vec<u8>,
+    pending: std::io::Cursor<Vec<u8>>,
+}
+
+pub(crate) fn xml_reader<R: std::io::BufRead>(input: R) -> quick_xml::Reader<std::io::BufReader<SpreadsheetXml<R>>> {
+    quick_xml::Reader::from_reader(std::io::BufReader::new(SpreadsheetXml {
+        reader: quick_xml::NsReader::from_reader(input),
+        buffer: Vec::new(),
+        pending: std::io::Cursor::new(Vec::new()),
+    }))
+}
+
+impl<R: std::io::BufRead> std::io::Read for SpreadsheetXml<R> {
+    fn read(&mut self, output: &mut [u8]) -> std::io::Result<usize> {
+        use quick_xml::{events::{BytesEnd, Event}, name::ResolveResult, Writer};
+        const MAIN: &[u8] = b"http://schemas.openxmlformats.org/spreadsheetml/2006/main";
+        if output.is_empty() { return Ok(0); }
+        loop {
+            let count = std::io::Read::read(&mut self.pending, output)?;
+            if count != 0 { return Ok(count); }
+            self.buffer.clear();
+            let (namespace, mut event) = self.reader.read_resolved_event_into(&mut self.buffer)
+                .map_err(|e| std::io::Error::new(std::io::ErrorKind::InvalidData, e))?;
+            if matches!(event, Event::Eof) { return Ok(0); }
+            if matches!(namespace, ResolveResult::Bound(ns) if ns.as_ref() == MAIN) {
+                match &mut event {
+                    Event::Start(start) | Event::Empty(start) => {
+                        let local = start.local_name().as_ref().to_vec();
+                        start.set_name(&local);
+                    }
+                    Event::End(end) => {
+                        let local = std::str::from_utf8(end.local_name().as_ref())
+                            .map_err(|e| std::io::Error::new(std::io::ErrorKind::InvalidData, e))?
+                            .to_owned();
+                        *end = BytesEnd::new(local);
+                    }
+                    _ => {}
+                }
+            }
+            self.pending.set_position(0);
+            self.pending.get_mut().clear();
+            Writer::new(self.pending.get_mut()).write_event(event)?;
+        }
+    }
+}
